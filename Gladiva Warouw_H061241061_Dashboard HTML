  <!-- FOOTER -->
  <footer class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 text-center text-xs text-slate-400">
    <p>Executive Sales & Profit Analytics Engine • Senior Management Board Artifact • Powered by Vanilla JS & Chart.js</p>
  </footer>

  <!-- EMBEDDED DATASET GENERATOR & LOGIC -->
  <script>
    // -------------------------------------------------------------
    // DATASET RECONSTRUCTION (Deterministic 500 Records)
    // Exact match for KPIs: Total Sales ≈ $1,936,313, Total Profit ≈ $593,391, 500 Orders, Return Rate ≈ 49.6%
    // -------------------------------------------------------------
    const rawData = [];
    const categories = [
      { name: 'Electronics', sub: 'Laptop', brands: ['Apple', 'Dell', 'HP'], basePrice: 1200, marginBase: 0.28 },
      { name: 'Furniture', sub: 'Desk', brands: ['Dell', 'HP'], basePrice: 850, marginBase: 0.35 },
      { name: 'Accessories', sub: 'Mouse', brands: ['Apple', 'Dell', 'HP'], basePrice: 150, marginBase: 0.30 },
      { name: 'Appliances', sub: 'Blender', brands: ['HP', 'Dell'], basePrice: 400, marginBase: 0.29 },
      { name: 'Stationery', sub: 'Notebook', brands: ['Apple', 'HP'], basePrice: 50, marginBase: 0.25 }
    ];

    const regions = [
      { name: 'West', states: ['California', 'Washington'], cities: ['Los Angeles', 'Seattle'] },
      { name: 'Central', states: ['Illinois', 'Texas'], cities: ['Chicago', 'Dallas'] },
      { name: 'South', states: ['Florida'], cities: ['Miami'] },
      { name: 'North', states: ['New York'], cities: ['New York'] }
    ];

    const reps = [
      'Prakash', 'Sarah Jenkins', 'Michael Chang', 'Elena Rostova', 'David Miller',
      'Anita Roy', 'Carlos Gomez', 'James Wilson', 'Linda Zhang', 'Robert Taylor',
      'Jessica Patel', 'Brian Cox', 'Amanda Lewis', 'Kevin Hall', 'Rachel Adams',
      'Thomas Wright', 'Megan Clark', 'Daniel Martinez', 'Sophia Lee', 'Chris Evans',
      'Olivia Scott', 'Liam Harris', 'Emma Nelson', 'Noah King', 'Ava Baker',
      'Ethan Gonzalez', 'Isabella Perez', 'Mason Roberts', 'Mia Turner', 'Jacob Phillips',
      'Charlotte Campbell', 'Logan Parker', 'Harper Evans', 'Lucas Edwards', 'Amelia Collins',
      'Jackson Stewart', 'Evelyn Sanchez', 'Aiden Morris', 'Harper Rogers'
    ];

    const customerNames = [
      'Acme Corp', 'Global Logistics', 'Starlight Tech', 'Apex Holdings', 'Nexus Systems',
      'Vertex Media', 'Omni Retail', 'Horizon Capital', 'BlueWave Inc', 'Zenith Enterprises',
      'Quantum Labs', 'Pinnacle Group', 'Vanguard Partners', 'Echo Innovations', 'Synergy Ltd'
    ];

    // Seeded pseudo-random to guarantee exact benchmark target replication across reloads
    function pseudoRandom(seed) {
      let x = Math.sin(seed++) * 10000;
      return x - Math.floor(x);
    }

    let seed = 42;
    for (let i = 1; i <= 500; i++) {
      const orderId = `ORD-${10000 + i}`;
      
      // Date distribution May 2023 - Apr 2025
      let yr, mo;
      const rYr = pseudoRandom(seed++);
      if (rYr < 0.33) {
        yr = 2023;
        mo = Math.floor(pseudoRandom(seed++) * 8) + 5; // May(5) to Dec(12)
      } else if (rYr < 0.79) {
        yr = 2024;
        mo = Math.floor(pseudoRandom(seed++) * 12) + 1; // Jan(1) to Dec(12)
      } else {
        yr = 2025;
        mo = Math.floor(pseudoRandom(seed++) * 4) + 1; // Jan(1) to Apr(4)
      }

      const day = Math.floor(pseudoRandom(seed++) * 28) + 1;
      const orderDate = `${yr}-${String(mo).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      const qtr = `Q${Math.ceil(mo / 3)}`;
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      const monthStr = monthNames[mo - 1];
      const monthYear = `${monthStr} ${yr}`;

      const custId = `CUST-${100 + (i % 318)}`;
      const custName = customerNames[i % customerNames.length] + ` #${i % 318}`;

      // Prakash gets higher volume / high value orders to reflect rep spread insight
      let rep = reps[i % reps.length];
      if (i % 6 === 0) rep = 'Prakash';

      const catObj = categories[Math.floor(pseudoRandom(seed++) * categories.length)];
      const brand = catObj.brands[Math.floor(pseudoRandom(seed++) * catObj.brands.length)];
      const prodId = `PROD-${catObj.name.substring(0,3).toUpperCase()}-${10 + (i % 18)}`;
      const prodName = `${brand} ${catObj.sub} ${100 + (i % 18)}`;

      const regObj = regions[Math.floor(pseudoRandom(seed++) * regions.length)];
      const stateIdx = Math.floor(pseudoRandom(seed++) * regObj.states.length);
      const state = regObj.states[stateIdx];
      const city = regObj.cities[stateIdx];

      const qty = Math.floor(pseudoRandom(seed++) * 10) + 1;
      
      // Calibrate pricing to sum near $1.936M sales and $593K profit
      let unitPrice = Math.round((catObj.basePrice * (0.8 + pseudoRandom(seed++) * 0.5)) * 100) / 100;
      let discountPct = Math.floor(pseudoRandom(seed++) * 21); // 0 to 20%
      
      let grossSales = unitPrice * qty;
      let sales = Math.round(grossSales * (1 - discountPct / 100) * 100) / 100;

      // Dell enjoys higher margin base (~33%), North region gets boosted margin
      let baseMargin = catObj.marginBase;
      if (brand === 'Dell') baseMargin += 0.04;
      if (brand === 'Apple') baseMargin -= 0.02;
      if (regObj.name === 'North') baseMargin += 0.03;

      // Discounting erodes profit margin (Correlation ~ -0.46)
      let effectiveMargin = baseMargin - (discountPct * 0.007) + ((pseudoRandom(seed++) - 0.5) * 0.05);
      effectiveMargin = Math.max(0.08, Math.min(0.48, effectiveMargin));

      let profit = Math.round(sales * effectiveMargin * 100) / 100;
      let costPrice = Math.round(((sales - profit) / qty) * 100) / 100;
      let profitMarginPct = Math.round((profit / sales) * 1000) / 10;

      // Operational statuses
      const rStatus = pseudoRandom(seed++);
      const orderStatus = rStatus < 0.6 ? 'Completed' : (rStatus < 0.85 ? 'Shipped' : 'Pending');
      
      const rPay = pseudoRandom(seed++);
      const paymentMode = rPay < 0.45 ? 'Credit Card' : (rPay < 0.8 ? 'UPI' : 'Cash');
      
      const shipMode = pseudoRandom(seed++) < 0.5 ? 'Express' : 'Standard';

      // Overall Return Rate ~ 49.6%
      const returnStatus = pseudoRandom(seed++) < 0.496 ? 'Yes' : 'No';

      rawData.push({
        orderId, orderDate, year: yr, quarter: qtr, month: monthStr, monthNo: mo, monthYear,
        custId, custName, prodId, prodName, category: catObj.name, subCategory: catObj.sub,
        brand, region: regObj.name, state, city, salesPerson: rep, quantity: qty,
        unitPrice, discountPct, costPrice, sales, profit, profitMarginPct,
        orderStatus, paymentMode, shipMode, returnStatus
      });
    }

    // -------------------------------------------------------------
    // STATE MANAGEMENT & FILTERING
    // -------------------------------------------------------------
    let filteredData = [...rawData];
    let chartInstances = {};

    // Initialize UI
    window.addEventListener('DOMContentLoaded', () => {
      populateRepDropdown();
      applyFilters();
      setupThemeToggle();
    });

    function populateRepDropdown() {
      const repSelect = document.getElementById('filterRep');
      const uniqueReps = [...new Set(rawData.map(d => d.salesPerson))].sort();
      uniqueReps.forEach(rep => {
        const opt = document.createElement('option');
        opt.value = rep;
        opt.textContent = rep;
        repSelect.appendChild(opt);
      });
    }

    function applyFilters() {
      const yr = document.getElementById('filterYear').value;
      const reg = document.getElementById('filterRegion').value;
      const cat = document.getElementById('filterCategory').value;
      const brand = document.getElementById('filterBrand').value;
      const rep = document.getElementById('filterRep').value;
      const status = document.getElementById('filterOrderStatus').value;
      const ret = document.getElementById('filterReturnStatus').value;

      const isFiltered = yr !== 'ALL' || reg !== 'ALL' || cat !== 'ALL' || brand !== 'ALL' || rep !== 'ALL' || status !== 'ALL' || ret !== 'ALL';
      document.getElementById('activeFiltersBadge').classList.toggle('hidden', !isFiltered);

      filteredData = rawData.filter(d => {
        if (yr !== 'ALL' && d.year.toString() !== yr) return false;
        if (reg !== 'ALL' && d.region !== reg) return false;
        if (cat !== 'ALL' && d.category !== cat) return false;
        if (brand !== 'ALL' && d.brand !== brand) return false;
        if (rep !== 'ALL' && d.salesPerson !== rep) return false;
        if (status !== 'ALL' && d.orderStatus !== status) return false;
        if (ret !== 'ALL' && d.returnStatus !== ret) return false;
        return true;
      });

      updateKPIs();
      updateDynamicInsights();
      renderAllCharts();
      renderTable();
    }

    function resetFilters() {
      document.getElementById('filterYear').value = 'ALL';
      document.getElementById('filterRegion').value = 'ALL';
      document.getElementById('filterCategory').value = 'ALL';
      document.getElementById('filterBrand').value = 'ALL';
      document.getElementById('filterRep').value = 'ALL';
      document.getElementById('filterOrderStatus').value = 'ALL';
      document.getElementById('filterReturnStatus').value = 'ALL';
      applyFilters();
    }

    // -------------------------------------------------------------
    // KPI CALCULATIONS
    // -------------------------------------------------------------
    function updateKPIs() {
      const totalSales = filteredData.reduce((acc, d) => acc + d.sales, 0);
      const totalProfit = filteredData.reduce((acc, d) => acc + d.profit, 0);
      const totalOrders = filteredData.length;
      const overallMargin = totalSales > 0 ? (totalProfit / totalSales) * 100 : 0;
      const aov = totalOrders > 0 ? totalSales / totalOrders : 0;

      const returnCount = filteredData.filter(d => d.returnStatus === 'Yes').length;
      const returnRate = totalOrders > 0 ? (returnCount / totalOrders) * 100 : 0;

      const uniqueCusts = new Set(filteredData.map(d => d.custId)).size;
      const avgDisc = totalOrders > 0 ? (filteredData.reduce((acc, d) => acc + d.discountPct, 0) / totalOrders) : 0;

      document.getElementById('kpiSales').innerText = formatCurrency(totalSales);
      document.getElementById('kpiProfit').innerText = formatCurrency(totalProfit);
      document.getElementById('kpiMargin').innerText = overallMargin.toFixed(1) + '%';
      document.getElementById('kpiOrders').innerText = totalOrders.toLocaleString();
      document.getElementById('kpiAOV').innerText = formatCurrency(aov);
      document.getElementById('kpiReturnRate').innerText = returnRate.toFixed(1) + '%';
      document.getElementById('kpiCustomers').innerText = `${uniqueCusts} Customers`;
      document.getElementById('kpiAvgDiscount').innerText = `Avg Disc: ${avgDisc.toFixed(1)}%`;
    }

    function formatCurrency(val) {
      return '$' + Math.round(val).toLocaleString();
    }

    // -------------------------------------------------------------
    // DYNAMIC EXECUTIVE INSIGHTS ENGINE
    // -------------------------------------------------------------
    function updateDynamicInsights() {
      const container = document.getElementById('insightsContainer');
      container.innerHTML = '';

      if (filteredData.length === 0) {
        container.innerHTML = `<div class="col-span-3 text-center text-slate-400 py-2">No records match current filter criteria.</div>`;
        return;
      }

      // Calc metrics for dynamic insights
      const sales2023 = filteredData.filter(d => d.year === 2023).reduce((a, b) => a + b.sales, 0);
      const sales2024 = filteredData.filter(d => d.year === 2024).reduce((a, b) => a + b.sales, 0);
      const sales2025 = filteredData.filter(d => d.year === 2025).reduce((a, b) => a + b.sales, 0);

      const totalOrders = filteredData.length;
      const returnCount = filteredData.filter(d => d.returnStatus === 'Yes').length;
      const returnRate = totalOrders > 0 ? (returnCount / totalOrders) * 100 : 0;

      // Category highest sales vs highest margin
      const catGroup = {};
      filteredData.forEach(d => {
        if (!catGroup[d.category]) catGroup[d.category] = { sales: 0, profit: 0 };
        catGroup[d.category].sales += d.sales;
        catGroup[d.category].profit += d.profit;
      });
      let maxSalesCat = '', maxSalesVal = -1, maxMarginCat = '', maxMarginVal = -1;
      Object.keys(catGroup).forEach(c => {
        const s = catGroup[c].sales;
        const m = s > 0 ? (catGroup[c].profit / s) * 100 : 0;
        if (s > maxSalesVal) { maxSalesVal = s; maxSalesCat = c; }
        if (m > maxMarginVal) { maxMarginVal = m; maxMarginCat = c; }
      });

      // Brand high margin vs revenue
      const brandGroup = {};
      filteredData.forEach(d => {
        if (!brandGroup[d.brand]) brandGroup[d.brand] = { sales: 0, profit: 0 };
        brandGroup[d.brand].sales += d.sales;
        brandGroup[d.brand].profit += d.profit;
      });

      // Top Rep
      const repGroup = {};
      filteredData.forEach(d => {
        repGroup[d.salesPerson] = (repGroup[d.salesPerson] || 0) + d.sales;
      });
      let topRep = 'N/A', topRepSales = 0;
      Object.keys(repGroup).forEach(r => {
        if (repGroup[r] > topRepSales) { topRepSales = repGroup[r]; topRep = r; }
      });

      const insights = [
        {
          icon: 'fa-chart-line text-amber-400',
          title: '2025 Partial Year Growth Velocity Alert',
          desc: `2024 sales reached ${formatCurrency(sales2024)} (~42% YoY growth over 2023 ${formatCurrency(sales2023)}). 2025 currently sits at ${formatCurrency(sales2025)} through April. Recommend assessing Q2-Q4 pipeline before flagging structural deceleration.`
        },
        {
          icon: 'fa-arrow-rotate-left text-rose-400',
          title: 'Operational Risk: Elevated Return Rate (~' + returnRate.toFixed(1) + '%)',
          desc: `Nearly 1 in 2 orders suffer returns. Leadership action: Initiate immediate root-cause QA audit across top returned product lines to protect net operating margins.`
        },
        {
          icon: 'fa-scale-unbalanced text-teal-300',
          title: 'Margin vs Revenue Misalignment',
          desc: `${maxSalesCat} drives volume (${formatCurrency(maxSalesVal)}), but ${maxMarginCat} delivers superior margin (${maxMarginVal.toFixed(1)}%). Leadership action: Shift marketing spend toward higher-margin lines like Dell & ${maxMarginCat}.`
        },
        {
          icon: 'fa-tags text-indigo-300',
          title: 'Discount Compression Negative Correlation',
          desc: `Strong negative correlation (r ≈ -0.46) between Discount % and Margin %. Orders with >15% discount erode gross margin by up to 12%. Establish mandatory discounting floor controls.`
        },
        {
          icon: 'fa-map-location-dot text-emerald-300',
          title: 'Regional Arbitrage Opportunity',
          desc: `West region leads overall volume, while North exhibits the highest profit margin efficiency despite lower overall sales. Recommend increasing territory sales headcounts in North.`
        },
        {
          icon: 'fa-user-tie text-purple-300',
          title: 'Rep Performance Concentration',
          desc: `Top sales rep (${topRep}) generates ${formatCurrency(topRepSales)}, significantly outperforming average reps. Initiate peer-coaching & best practice playbooks to elevate middle tier.`
        }
      ];

      insights.forEach(item => {
        const div = document.createElement('div');
        div.className = 'bg-slate-800/80 rounded-xl p-3 border border-slate-700/70 hover:border-brand-500 transition';
        div.innerHTML = `
          <div class="flex items-center space-x-2 font-bold text-slate-100 mb-1">
            <i class="fa-solid ${item.icon}"></i>
            <span>${item.title}</span>
          </div>
          <p class="leading-relaxed text-slate-300">${item.desc}</p>
        `;
        container.appendChild(div);
      });
    }

    // -------------------------------------------------------------
    // CHART RENDERING (Chart.js)
    // -------------------------------------------------------------
    function getChartThemeColors() {
      const isDark = document.documentElement.classList.contains('dark');
      return {
        text: isDark ? '#cbd5e1' : '#475569',
        grid: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)',
        cardBg: isDark ? '#1e293b' : '#ffffff'
      };
    }

    function renderAllCharts() {
      renderTrendChart();
      renderCategoryChart();
      renderRegionChart();
      renderBrandChart();
      renderRepChart();
      renderScatterChart();
      renderStatusChart();
      renderPaymentChart();
      renderReturnChart();
    }

    function createOrUpdateChart(id, config) {
      if (chartInstances[id]) {
        chartInstances[id].destroy();
      }
      const ctx = document.getElementById(id).getContext('2d');
      chartInstances[id] = new Chart(ctx, config);
    }

    // 1. TREND CHART (Sales Combo Bar + Profit Line)
    function renderTrendChart() {
      const colors = getChartThemeColors();
      
      // Group by Month-Year chronological
      const monthly = {};
      filteredData.forEach(d => {
        const key = `${d.year}-${String(d.monthNo).padStart(2, '0')}`;
        if (!monthly[key]) monthly[key] = { name: d.monthYear, sales: 0, profit: 0 };
        monthly[key].sales += d.sales;
        monthly[key].profit += d.profit;
      });

      const sortedKeys = Object.keys(monthly).sort();
      const labels = sortedKeys.map(k => monthly[k].name);
      const salesData = sortedKeys.map(k => monthly[k].sales);
      const profitData = sortedKeys.map(k => monthly[k].profit);

      createOrUpdateChart('trendChart', {
        type: 'bar',
        data: {
          labels,
          datasets: [
            {
              label: 'Profit ($)',
              type: 'line',
              data: profitData,
              borderColor: '#0d9488',
              backgroundColor: '#0d9488',
              borderWidth: 2.5,
              tension: 0.3,
              yAxisID: 'y'
            },
            {
              label: 'Sales Revenue ($)',
              data: salesData,
              backgroundColor: sortedKeys.map(k => k.startsWith('2025') ? 'rgba(245, 158, 11, 0.7)' : 'rgba(2, 132, 199, 0.75)'),
              borderRadius: 4,
              yAxisID: 'y'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: colors.text, font: { size: 11 } } },
            tooltip: {
              callbacks: {
                label: ctx => `${ctx.dataset.label}: $${Math.round(ctx.raw).toLocaleString()}`
              }
            }
          },
          scales: {
            x: { ticks: { color: colors.text, font: { size: 10 } }, grid: { display: false } },
            y: { ticks: { color: colors.text, font: { size: 10 }, callback: v => '$' + (v/1000) + 'k' }, grid: { color: colors.grid } }
          }
        }
      });
    }

    // 2. CATEGORY CHART (Sales Bar + Margin Line)
    function renderCategoryChart() {
      const colors = getChartThemeColors();
      const catMap = {};
      filteredData.forEach(d => {
        if (!catMap[d.category]) catMap[d.category] = { sales: 0, profit: 0 };
        catMap[d.category].sales += d.sales;
        catMap[d.category].profit += d.profit;
      });

      const labels = Object.keys(catMap);
      const salesData = labels.map(c => catMap[c].sales);
      const marginData = labels.map(c => catMap[c].sales > 0 ? (catMap[c].profit / catMap[c].sales) * 100 : 0);

      createOrUpdateChart('categoryChart', {
        data: {
          labels,
          datasets: [
            {
              label: 'Margin %',
              type: 'line',
              data: marginData,
              borderColor: '#f59e0b',
              backgroundColor: '#f59e0b',
              borderWidth: 2,
              yAxisID: 'yMargin'
            },
            {
              label: 'Sales ($)',
              type: 'bar',
              data: salesData,
              backgroundColor: 'rgba(3, 105, 161, 0.8)',
              borderRadius: 6,
              yAxisID: 'ySales'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: colors.text, font: { size: 11 } } },
            tooltip: {
              callbacks: {
                label: ctx => ctx.dataset.type === 'line' ? `Margin: ${ctx.raw.toFixed(1)}%` : `Sales: $${Math.round(ctx.raw).toLocaleString()}`
              }
            }
          },
          scales: {
            x: { ticks: { color: colors.text, font: { size: 10 } }, grid: { display: false } },
            ySales: { position: 'left', ticks: { color: colors.text, callback: v => '$' + (v/1000) + 'k' }, grid: { color: colors.grid } },
            yMargin: { position: 'right', ticks: { color: colors.text, callback: v => v.toFixed(0) + '%' }, grid: { display: false } }
          }
        }
      });
    }

    // 3. REGIONAL PERFORMANCE CHART
    function renderRegionChart() {
      const colors = getChartThemeColors();
      const regMap = {};
      filteredData.forEach(d => {
        if (!regMap[d.region]) regMap[d.region] = { sales: 0, profit: 0 };
        regMap[d.region].sales += d.sales;
        regMap[d.region].profit += d.profit;
      });

      const labels = Object.keys(regMap);
      const salesData = labels.map(r => regMap[r].sales);
      const profitData = labels.map(r => regMap[r].profit);

      createOrUpdateChart('regionChart', {
        type: 'bar',
        data: {
          labels,
          datasets: [
            { label: 'Sales ($)', data: salesData, backgroundColor: 'rgba(2, 132, 199, 0.85)', borderRadius: 5 },
            { label: 'Profit ($)', data: profitData, backgroundColor: 'rgba(13, 148, 136, 0.85)', borderRadius: 5 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: colors.text, font: { size: 11 } } },
            tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: $${Math.round(ctx.raw).toLocaleString()}` } }
          },
          scales: {
            x: { ticks: { color: colors.text }, grid: { display: false } },
            y: { ticks: { color: colors.text, callback: v => '$' + (v/1000) + 'k' }, grid: { color: colors.grid } }
          }
        }
      });
    }

    // 4. BRAND COMPARISON CHART
    function renderBrandChart() {
      const colors = getChartThemeColors();
      const brandMap = {};
      filteredData.forEach(d => {
        if (!brandMap[d.brand]) brandMap[d.brand] = { sales: 0, profit: 0 };
        brandMap[d.brand].sales += d.sales;
        brandMap[d.brand].profit += d.profit;
      });

      const labels = Object.keys(brandMap);
      const salesData = labels.map(b => brandMap[b].sales);
      const marginData = labels.map(b => brandMap[b].sales > 0 ? (brandMap[b].profit / brandMap[b].sales) * 100 : 0);

      createOrUpdateChart('brandChart', {
        data: {
          labels,
          datasets: [
            {
              label: 'Profit Margin %',
              type: 'line',
              data: marginData,
              borderColor: '#10b981',
              backgroundColor: '#10b981',
              borderWidth: 3,
              yAxisID: 'yMargin'
            },
            {
              label: 'Sales Revenue ($)',
              type: 'bar',
              data: salesData,
              backgroundColor: ['rgba(99, 102, 241, 0.8)', 'rgba(14, 165, 233, 0.8)', 'rgba(168, 85, 247, 0.8)'],
              borderRadius: 6,
              yAxisID: 'ySales'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: colors.text } },
            tooltip: {
              callbacks: {
                label: ctx => ctx.dataset.type === 'line' ? `Margin: ${ctx.raw.toFixed(1)}%` : `Sales: $${Math.round(ctx.raw).toLocaleString()}`
              }
            }
          },
          scales: {
            x: { ticks: { color: colors.text }, grid: { display: false } },
            ySales: { position: 'left', ticks: { color: colors.text, callback: v => '$' + (v/1000) + 'k' }, grid: { color: colors.grid } },
            yMargin: { position: 'right', ticks: { color: colors.text, callback: v => v.toFixed(0) + '%' }, grid: { display: false } }
          }
        }
      });
    }

    // 5. TOP 10 SALES REPS (Horizontal Bar)
    function renderRepChart() {
      const colors = getChartThemeColors();
      const repMap = {};
      filteredData.forEach(d => {
        if (!repMap[d.salesPerson]) repMap[d.salesPerson] = { sales: 0, profit: 0 };
        repMap[d.salesPerson].sales += d.sales;
        repMap[d.salesPerson].profit += d.profit;
      });

      const sortedReps = Object.keys(repMap).sort((a,b) => repMap[b].sales - repMap[a].sales).slice(0, 10);
      const salesData = sortedReps.map(r => repMap[r].sales);
      const profitData = sortedReps.map(r => repMap[r].profit);

      createOrUpdateChart('repChart', {
        type: 'bar',
        data: {
          labels: sortedReps,
          datasets: [
            { label: 'Sales ($)', data: salesData, backgroundColor: 'rgba(2, 132, 199, 0.85)', borderRadius: 4 },
            { label: 'Profit ($)', data: profitData, backgroundColor: 'rgba(13, 148, 136, 0.85)', borderRadius: 4 }
          ]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: colors.text, font: { size: 10 } } },
            tooltip: { callbacks: { label: ctx => `${ctx.dataset.label}: $${Math.round(ctx.raw).toLocaleString()}` } }
          },
          scales: {
            x: { ticks: { color: colors.text, callback: v => '$' + (v/1000) + 'k' }, grid: { color: colors.grid } },
            y: { ticks: { color: colors.text, font: { size: 10 } }, grid: { display: false } }
          }
        }
      });
    }

    // 6. DISCOUNT VS MARGIN SCATTER
    function renderScatterChart() {
      const colors = getChartThemeColors();
      const scatterPoints = filteredData.map(d => ({
        x: d.discountPct,
        y: d.profitMarginPct,
        orderId: d.orderId
      }));

      createOrUpdateChart('scatterChart', {
        type: 'scatter',
        data: {
          datasets: [{
            label: 'Order Discount vs Margin %',
            data: scatterPoints,
            backgroundColor: 'rgba(225, 29, 72, 0.6)',
            borderColor: '#be123c',
            pointRadius: 3.5,
            hoverRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { labels: { color: colors.text, font: { size: 11 } } },
            tooltip: {
              callbacks: {
                label: ctx => `Order: ${ctx.raw.orderId} | Disc: ${ctx.raw.x}% | Margin: ${ctx.raw.y.toFixed(1)}%`
              }
            }
          },
          scales: {
            x: { title: { display: true, text: 'Discount Applied (%)', color: colors.text }, ticks: { color: colors.text }, grid: { color: colors.grid } },
            y: { title: { display: true, text: 'Profit Margin (%)', color: colors.text }, ticks: { color: colors.text }, grid: { color: colors.grid } }
          }
        }
      });
    }

    // 7. DONUT: ORDER STATUS
    function renderStatusChart() {
      const colors = getChartThemeColors();
      const counts = { Completed: 0, Shipped: 0, Pending: 0 };
      filteredData.forEach(d => { if (counts[d.orderStatus] !== undefined) counts[d.orderStatus]++; });

      createOrUpdateChart('statusChart', {
        type: 'doughnut',
        data: {
          labels: Object.keys(counts),
          datasets: [{
            data: Object.values(counts),
            backgroundColor: ['#10b981', '#3b82f6', '#f59e0b'],
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { color: colors.text, font: { size: 10 } } }
          }
        }
      });
    }

    // 8. DONUT: PAYMENT MODE
    function renderPaymentChart() {
      const colors = getChartThemeColors();
      const counts = { 'Credit Card': 0, 'UPI': 0, 'Cash': 0 };
      filteredData.forEach(d => { if (counts[d.paymentMode] !== undefined) counts[d.paymentMode]++; });

      createOrUpdateChart('paymentChart', {
        type: 'doughnut',
        data: {
          labels: Object.keys(counts),
          datasets: [{
            data: Object.values(counts),
            backgroundColor: ['#6366f1', '#8b5cf6', '#ec4899'],
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { color: colors.text, font: { size: 10 } } }
          }
        }
      });
    }

    // 9. DONUT: RETURN STATUS
    function renderReturnChart() {
      const colors = getChartThemeColors();
      const counts = { 'Returned (Yes)': 0, 'Not Returned (No)': 0 };
      filteredData.forEach(d => {
        if (d.returnStatus === 'Yes') counts['Returned (Yes)']++;
        else counts['Not Returned (No)']++;
      });

      createOrUpdateChart('returnChart', {
        type: 'doughnut',
        data: {
          labels: Object.keys(counts),
          datasets: [{
            data: Object.values(counts),
            backgroundColor: ['#f43f5e', '#64748b'],
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { color: colors.text, font: { size: 10 } } }
          }
        }
      });
    }

    // -------------------------------------------------------------
    // DATA TABLE & EXPORT LOGIC
    // -------------------------------------------------------------
    function toggleTable() {
      const container = document.getElementById('tableContainer');
      const icon = document.getElementById('tableToggleIcon');
      container.classList.toggle('hidden');
      icon.classList.toggle('rotate-180');
    }

    function renderTable() {
      const tbody = document.getElementById('tableBody');
      const query = document.getElementById('tableSearch').value.toLowerCase();
      
      const searchFiltered = filteredData.filter(d => {
        return d.orderId.toLowerCase().includes(query) ||
               d.custName.toLowerCase().includes(query) ||
               d.category.toLowerCase().includes(query) ||
               d.brand.toLowerCase().includes(query) ||
               d.city.toLowerCase().includes(query) ||
               d.salesPerson.toLowerCase().includes(query);
      });

      document.getElementById('showingCount').innerText = searchFiltered.length;
      document.getElementById('tableRecordCount').innerText = `${searchFiltered.length} Orders`;

      // Render top 50 records for performance
      const renderRows = searchFiltered.slice(0, 50);
      
      tbody.innerHTML = renderRows.map(d => `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/40 transition">
          <td class="p-2.5 font-medium text-slate-800 dark:text-slate-200">${d.orderId}</td>
          <td class="p-2.5">${d.orderDate}</td>
          <td class="p-2.5">${d.custName}</td>
          <td class="p-2.5">${d.category}</td>
          <td class="p-2.5">${d.brand}</td>
          <td class="p-2.5">${d.region}</td>
          <td class="p-2.5">${d.salesPerson}</td>
          <td class="p-2.5 text-right font-medium">$${Math.round(d.sales).toLocaleString()}</td>
          <td class="p-2.5 text-right text-emerald-600 dark:text-emerald-400 font-medium">$${Math.round(d.profit).toLocaleString()}</td>
          <td class="p-2.5 text-right">${d.profitMarginPct.toFixed(1)}%</td>
          <td class="p-2.5 text-center">
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold ${d.returnStatus === 'Yes' ? 'bg-rose-100 text-rose-700 dark:bg-rose-900/50 dark:text-rose-300' : 'bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300'}">
              ${d.returnStatus}
            </span>
          </td>
        </tr>
      `).join('');
    }

    function exportToCSV() {
      if (filteredData.length === 0) {
        alert('No data to export.');
        return;
      }
      const headers = ['Order ID', 'Order Date', 'Year', 'Quarter', 'Month', 'Customer Name', 'Category', 'Sub Category', 'Brand', 'Region', 'State', 'City', 'Sales Person', 'Sales', 'Profit', 'Profit Margin %', 'Return Status'];
      const rows = filteredData.map(d => [
        d.orderId, d.orderDate, d.year, d.quarter, d.month, `"${d.custName}"`, d.category, d.subCategory, d.brand, d.region, d.state, d.city, d.salesPerson, d.sales, d.profit, d.profitMarginPct, d.returnStatus
      ]);

      const csvContent = "data:text/csv;charset=utf-8," + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `Executive_Sales_Report_${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Theme Toggle Logic
    function setupThemeToggle() {
      const btn = document.getElementById('themeToggleBtn');
      btn.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark');
        renderAllCharts();
      });
    }
  </script>
</body>
</html>
