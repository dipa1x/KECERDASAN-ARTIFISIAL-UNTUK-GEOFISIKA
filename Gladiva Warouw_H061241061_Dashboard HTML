<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Executive Sales & Profit Dashboard</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0f7ff',
              100: '#e0effe',
              500: '#0284c7',
              600: '#0369a1',
              700: '#075985',
              800: '#0c4a6e',
              900: '#0f172a',
            },
            tealAccent: '#0d9488',
          }
        }
      }
    }
  </script>
  <!-- FontAwesome & Google Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    .dark .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #475569;
    }
  </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 transition-colors duration-200 min-h-screen pb-12">

  <!-- TOP BAR / HEADER -->
  <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex items-center space-x-3">
        <div class="p-2.5 bg-brand-600 text-white rounded-xl shadow-md">
          <i class="fa-solid me-0 fa-chart-line text-xl"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">Executive Sales & Profit Dashboard</h1>
            <span class="bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-300 text-xs px-2 py-0.5 rounded-full font-medium border border-amber-200 dark:border-amber-700">
              <i class="fa-solid fa-triangle-exclamation mr-1"></i>2025 Partial Year (thru Apr)
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Dataset Span: May 2023 – Apr 2025 | 500 Orders | Real-Time Senior Leadership Analytics
          </p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center space-x-2 self-end md:self-auto">
        <button id="themeToggleBtn" class="p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg text-sm font-medium transition" title="Toggle Theme">
          <i class="fa-solid fa-moon dark:hidden"></i>
          <i class="fa-solid fa-sun hidden dark:inline text-amber-400"></i>
        </button>
        <button onclick="exportToCSV()" class="inline-flex items-center space-x-1.5 px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-xs font-semibold rounded-lg transition">
          <i class="fa-solid fa-download"></i>
          <span>Export CSV</span>
        </button>
        <button onclick="window.print()" class="inline-flex items-center space-x-1.5 px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg transition shadow-sm">
          <i class="fa-solid fa-print"></i>
          <span>Print / PDF</span>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-6">

    <!-- STICKY FILTER CONTROL PANEL -->
    <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm">
      <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100 dark:border-slate-700">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-filter text-brand-600 text-sm"></i>
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">Interactive Slicers & Filters</h2>
          <span id="activeFiltersBadge" class="hidden text-xs bg-brand-100 text-brand-700 px-2 py-0.5 rounded-full font-medium">Filtered</span>
        </div>
        <button onclick="resetFilters()" class="text-xs text-brand-600 dark:text-brand-400 hover:text-brand-800 dark:hover:text-brand-300 font-semibold flex items-center space-x-1">
          <i class="fa-solid fa-rotate-left text-[10px]"></i>
          <span>Reset Filters</span>
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-3">
        <!-- Year -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Year</label>
          <select id="filterYear" onchange="applyFilters()" class="w-full text-xs bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ALL">All Years</option>
            <option value="2023">2023</option>
            <option value="2024">2024</option>
            <option value="2025">2025 (Partial)</option>
          </select>
        </div>

        <!-- Region -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Region</label>
          <select id="filterRegion" onchange="applyFilters()" class="w-full text-xs bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ALL">All Regions</option>
            <option value="Central">Central</option>
            <option value="North">North</option>
            <option value="South">South</option>
            <option value="West">West</option>
          </select>
        </div>

        <!-- Category -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Category</label>
          <select id="filterCategory" onchange="applyFilters()" class="w-full text-xs bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ALL">All Categories</option>
            <option value="Electronics">Electronics</option>
            <option value="Furniture">Furniture</option>
            <option value="Accessories">Accessories</option>
            <option value="Appliances">Appliances</option>
            <option value="Stationery">Stationery</option>
          </select>
        </div>

        <!-- Brand -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Brand</label>
          <select id="filterBrand" onchange="applyFilters()" class="w-full text-xs bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ALL">All Brands</option>
            <option value="Apple">Apple</option>
            <option value="Dell">Dell</option>
            <option value="HP">HP</option>
          </select>
        </div>

        <!-- Sales Person -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Sales Rep</label>
          <select id="filterRep" onchange="applyFilters()" class="w-full text-xs bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ALL">All Reps (39)</option>
          </select>
        </div>

        <!-- Order Status -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Order Status</label>
          <select id="filterOrderStatus" onchange="applyFilters()" class="w-full text-xs bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ALL">All Statuses</option>
            <option value="Completed">Completed</option>
            <option value="Shipped">Shipped</option>
            <option value="Pending">Pending</option>
          </select>
        </div>

        <!-- Return Status -->
        <div>
          <label class="block text-[11px] font-semibold text-slate-500 dark:text-slate-400 mb-1">Return Status</label>
          <select id="filterReturnStatus" onchange="applyFilters()" class="w-full text-xs bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg p-2 focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="ALL">All Orders</option>
            <option value="Yes">Returned Only</option>
            <option value="No">Not Returned</option>
          </select>
        </div>
      </div>
    </section>

    <!-- KPI HEADER CARDS ROW -->
    <section class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-4">
      <!-- Total Sales -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm hover:shadow transition">
        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
          <span class="text-xs font-semibold">Total Revenue</span>
          <i class="fa-solid fa-dollar-sign text-emerald-500 text-xs"></i>
        </div>
        <div id="kpiSales" class="text-lg md:text-xl font-bold text-slate-900 dark:text-white">$0</div>
        <div id="kpiSalesTrend" class="text-[10px] text-slate-500 mt-1 flex items-center space-x-1">
          <span>vs full baseline</span>
        </div>
      </div>

      <!-- Total Profit -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm hover:shadow transition">
        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
          <span class="text-xs font-semibold">Total Profit</span>
          <i class="fa-solid fa-piggy-bank text-brand-500 text-xs"></i>
        </div>
        <div id="kpiProfit" class="text-lg md:text-xl font-bold text-slate-900 dark:text-white">$0</div>
        <div id="kpiProfitTrend" class="text-[10px] text-slate-500 mt-1">Net profit generated</div>
      </div>

      <!-- Profit Margin % -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm hover:shadow transition">
        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
          <span class="text-xs font-semibold">Margin %</span>
          <i class="fa-solid fa-percent text-tealAccent text-xs"></i>
        </div>
        <div id="kpiMargin" class="text-lg md:text-xl font-bold text-slate-900 dark:text-white">0.0%</div>
        <div class="text-[10px] text-slate-500 mt-1">Profit ÷ Revenue</div>
      </div>

      <!-- Total Orders -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm hover:shadow transition">
        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
          <span class="text-xs font-semibold">Total Orders</span>
          <i class="fa-solid fa-cart-shopping text-purple-500 text-xs"></i>
        </div>
        <div id="kpiOrders" class="text-lg md:text-xl font-bold text-slate-900 dark:text-white">0</div>
        <div class="text-[10px] text-slate-500 mt-1">Unique orders</div>
      </div>

      <!-- Avg Order Value -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm hover:shadow transition">
        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
          <span class="text-xs font-semibold">Avg Order Value</span>
          <i class="fa-solid fa-receipt text-amber-500 text-xs"></i>
        </div>
        <div id="kpiAOV" class="text-lg md:text-xl font-bold text-slate-900 dark:text-white">$0</div>
        <div class="text-[10px] text-slate-500 mt-1">Revenue per order</div>
      </div>

      <!-- Return Rate % -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm hover:shadow transition">
        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
          <span class="text-xs font-semibold">Return Rate</span>
          <i class="fa-solid fa-arrow-rotate-left text-rose-500 text-xs"></i>
        </div>
        <div id="kpiReturnRate" class="text-lg md:text-xl font-bold text-rose-600 dark:text-rose-400">0.0%</div>
        <div class="text-[10px] text-rose-500/80 font-medium mt-1">
          <i class="fa-solid fa-triangle-exclamation text-[9px] mr-1"></i>High Risk Zone
        </div>
      </div>

      <!-- Customers & Avg Discount -->
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-4 shadow-sm hover:shadow transition">
        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-1">
          <span class="text-xs font-semibold">Customers & Disc.</span>
          <i class="fa-solid fa-users text-indigo-500 text-xs"></i>
        </div>
        <div id="kpiCustomers" class="text-base font-bold text-slate-900 dark:text-white">0 Cust</div>
        <div id="kpiAvgDiscount" class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-0.5">Avg Disc: 0%</div>
      </div>
    </section>

    <!-- DYNAMIC EXECUTIVE INSIGHTS PANEL -->
    <section class="bg-gradient-to-r from-slate-900 to-brand-900 text-white rounded-2xl p-5 shadow-md border border-slate-800">
      <div class="flex items-center justify-between mb-3 border-b border-slate-700/60 pb-2">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-lightbulb text-amber-400 text-base"></i>
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-200">Dynamic Executive Decision Insights</h3>
        </div>
        <span class="text-[10px] text-slate-400 bg-slate-800 px-2.5 py-1 rounded-full border border-slate-700">Auto-Computed from Filter State</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 text-xs text-slate-300" id="insightsContainer">
        <!-- Dynamic Insights dynamically injected here -->
      </div>
    </section>

    <!-- VISUALIZATIONS GRID -->

    <!-- ROW 1: Trend Over Time & Category Performance -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Sales & Profit Trend -->
      <div class="lg:col-span-7 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Sales & Profit Trend Over Time</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Monthly breakdown highlighting 2023-2024 expansion and 2025 partial-year window</p>
          </div>
          <span class="text-[10px] bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300 px-2 py-0.5 rounded font-medium">
            2025 Partial Thru April
          </span>
        </div>
        <div class="h-72 relative">
          <canvas id="trendChart"></canvas>
        </div>
      </div>

      <!-- Category Breakdown -->
      <div class="lg:col-span-5 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Sales & Margin % by Category</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Comparing volume driver vs profitability driver</p>
          </div>
        </div>
        <div class="h-72 relative">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>
    </div>

    <!-- ROW 2: Regional Performance & Brand Comparison -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Regional Performance -->
      <div class="lg:col-span-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Regional Performance Matrix</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">West dominates volume; North commands highest profit margin</p>
          </div>
        </div>
        <div class="h-72 relative">
          <canvas id="regionChart"></canvas>
        </div>
      </div>

      <!-- Brand Comparison -->
      <div class="lg:col-span-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Brand Revenue vs. Profit Margin</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Dell delivers superior margin (~33%) vs Apple & HP</p>
          </div>
        </div>
        <div class="h-72 relative">
          <canvas id="brandChart"></canvas>
        </div>
      </div>
    </div>

    <!-- ROW 3: Top Sales Reps & Discount Correlation Scatter -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Top Sales Reps -->
      <div class="lg:col-span-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Top 10 Sales Representatives</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Ranked by Sales with net profit contribution</p>
          </div>
        </div>
        <div class="h-72 relative">
          <canvas id="repChart"></canvas>
        </div>
      </div>

      <!-- Discount vs Margin Scatter -->
      <div class="lg:col-span-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">Discount % vs Profit Margin % Scatter</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Proves discounting erosion (Correlation ≈ -0.46)</p>
          </div>
        </div>
        <div class="h-72 relative">
          <canvas id="scatterChart"></canvas>
        </div>
      </div>
    </div>

    <!-- ROW 4: OPERATIONAL DONUTS -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2 text-center">Order Status Split</h3>
        <div class="h-52 relative">
          <canvas id="statusChart"></canvas>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2 text-center">Payment Mode Distribution</h3>
        <div class="h-52 relative">
          <canvas id="paymentChart"></canvas>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2 text-center">Return Status Breakdown</h3>
        <div class="h-52 relative">
          <canvas id="returnChart"></canvas>
        </div>
      </div>
    </div>

    <!-- COLLAPSIBLE DATA TABLE -->
    <section class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-5 shadow-sm">
      <div class="flex items-center justify-between mb-4 cursor-pointer" onclick="toggleTable()">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-table text-brand-600"></i>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Transaction Detail Drill-Down</h3>
          <span id="tableRecordCount" class="text-xs text-slate-500 bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded-full">500 Orders</span>
        </div>
        <div class="flex items-center space-x-3">
          <span class="text-xs text-brand-600 font-medium">Toggle View</span>
          <i id="tableToggleIcon" class="fa-solid fa-chevron-down text-slate-400 transition-transform duration-200"></i>
        </div>
      </div>

      <div id="tableContainer" class="hidden transition-all duration-300">
        <!-- Table Search / Controls -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-3">
          <div class="relative w-full sm:w-64">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
            <input type="text" id="tableSearch" onkeyup="renderTable()" placeholder="Search customer, SKU, city..." class="w-full text-xs pl-8 pr-3 py-1.5 bg-slate-50 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-500">
          </div>
          <div class="text-xs text-slate-500">
            Showing <span id="showingCount" class="font-semibold text-slate-700 dark:text-slate-200">0</span> records
          </div>
        </div>

        <div class="overflow-x-auto custom-scrollbar border border-slate-200 dark:border-slate-700 rounded-xl">
          <table class="w-full text-left text-xs text-slate-600 dark:text-slate-300">
            <thead class="bg-slate-100 dark:bg-slate-700/70 text-slate-700 dark:text-slate-200 font-semibold border-b border-slate-200 dark:border-slate-700">
              <tr>
                <th class="p-2.5">Order ID</th>
                <th class="p-2.5">Date</th>
                <th class="p-2.5">Customer</th>
                <th class="p-2.5">Category</th>
                <th class="p-2.5">Brand</th>
                <th class="p-2.5">Region</th>
                <th class="p-2.5">Rep</th>
                <th class="p-2.5 text-right">Sales</th>
                <th class="p-2.5 text-right">Profit</th>
                <th class="p-2.5 text-right">Margin %</th>
                <th class="p-2.5 text-center">Returned</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-slate-100 dark:divide-slate-700/50">
              <!-- Dynamically populated -->
